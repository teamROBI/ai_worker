# Local private TLS key used by the legacy VR development package.
/archive/robot/teleop/ffw_teleop_vr/cert/key.pem

# Camera recordings generated by the local recording helper.
videos/

# Device-local environments, build outputs and generated extension bundles.
.venv/
node_modules/
build/
install/
log/
dist/
*.foxe

# Track the PC control project's Python version (ignored by upstream).
!/pc/control/.python-version

# Keep archived ROS packages out of normal workspace discovery/builds.
!/archive/COLCON_IGNORE
